{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-core/tauri-v2/core/tauri-config-schema/schema.json",
  "productName": "Gravitation Cubed",
  "version": "2.0.0",
  "identifier": "com.gravitation3.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Gravitation Cubed",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
