{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/node_modules/@nicegui/tauri/config.schema.json",
  "productName": "Gravitation3",
  "version": "0.1.0",
  "identifier": "com.gravitation3.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Gravitation3",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
